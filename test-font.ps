%!PS-Adobe-3.0


%ps2pdf -dNOSAFER test-font.ps - ключи вызова
(../ps-steal/steal.ps) run

(eskd-font.ps) stealfile
(../ps-eskd/) stealfolder

/mesh {
newpath
30 1 200 {
	dup
	270 moveto
	20 lineto
} for

20 1 270 {
	dup
	30 exch
	moveto
	200 exch
	lineto
} for
stroke
} def

/moverow {
	30 250 17 4 -1 roll mul sub moveto
} def

in2mm

0.1 setlinewidth

mesh


%/eskd-b-font findfont
/eskd-b-orto-font findfont
10 scalefont
setfont

0 moverow

%ГЕ ПНЦТ ШЩ
(ГЕЁ ПНЦТ ШЩ) utf8show

%
