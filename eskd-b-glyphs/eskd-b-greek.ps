<<
	/GreekCapitalLetterAlpha {
		CyrillicCapitalLetterA
	}
	/GreekCapitalLetterBeta {CyrillicCapitalLetterVe}
	/GreekCapitalLetterGamma {CyrillicCapitalLetterGhe}
	/GreekCapitalLetterDelta {
		7 setconfig uppertop
		A moveto
		N lineto
		D lineto
		A lineto
		closepath
	}
	/GreekCapitalLetterEpsilon {CyrillicCapitalLetterIe}
	/GreekCapitalLetterZeta {LatinCapitalLetterZ}
	/GreekCapitalLetterEta {LatinCapitalLetterH}
	/GreekCapitalLetterTheta {
		6 setconfig 
		uppertop middleceil
		A moveto
		2 C gliphO
		Q moveto
		-1 0 rmoveto
		2 0 rlineto
	}
	/GreekCapitalLetterIota {LatinCapitalLetterI}
	/GreekCapitalLetterKappa {LatinCapitalLetterK}
	/GreekCapitalLetterLamda {
		7 setconfig uppertop
		A moveto
		N lineto
		D lineto
	}
	/GreekCapitalLetterMu {LatinCapitalLetterM}
	/GreekCapitalLetterNu {LatinCapitalLetterN}
	/GreekCapitalLetterXi {
		6 setconfig 
		uppertop middleceil
		A moveto D lineto
		B moveto C lineto
		Q moveto
		-2 0 rmoveto
		4 0 rlineto
	}
	/GreekCapitalLetterOmicron {LatinCapitalLetterO}
	/GreekCapitalLetterPi {CyrillicCapitalLetterPe}
	/GreekCapitalLetterRho {CyrillicCapitalLetterEr}
	/GreekCapitalLetterSigma {
		6 setconfig uppertop
		/center 2 def
		C moveto
		B lineto
		Q lineto
		A lineto
		D lineto
	}
	/GreekCapitalLetterTau {LatinCapitalLetterT}
	/GreekCapitalLetterUpsilon {LatinCapitalLetterY}
	/GreekCapitalLetterPhi {
		9 setconfig uppertop middlefloor
		N moveto
		P lineto
		0 1.5 moveto

		3 
		right 
		top 1.5 sub 
		gliphO
	}
	/GreekCapitalLetterChi {LatinCapitalLetterX}
	/GreekCapitalLetterPsi {
		7 setconfig uppertop 
		/middle 2.5 def
		N moveto
		P lineto
		B moveto
		2.5 [M O C] many-arct
		lineto
	}
	/GreekCapitalLetterOmega {
		7 setconfig uppertop
		0.5 0 moveto
		2 0 lineto
		2 1.5 lineto
		M 2 arcXY
		N 3 arcYX
		O 3 arcXY
		D translate
		-2 1.5 2 arcYX
		-2 0 lineto
		-0.5 0 lineto
		A translate
		
	}
	/GreekSmallLetterAlpha {
		6 setconfig lowertop
		/center 3 def
		C moveto
		2 [P A B N D] many-arct
		lineto
	}
	/GreekSmallLetterBeta {
		5 setconfig uppertop middleceil
		/center 2 def
		A -3  add moveto
		N 2 arcYX
		2
		O 0.5 0 2sub gliphC
		2 D gliphC
	}
	/GreekSmallLetterGamma {
		5 setconfig lowertop
		/bottom -3 def
		/middle 2 def
		B moveto
		/left inc
		/right dec 
		1.5 [B O] many-arct lineto
		/left inc
		0.5 [D A M] many-arct lineto
		/right inc
		1.5 [C] many-arct lineto
		
	}
	/GreekSmallLetterDelta {
		5 setconfig lowertop
		A moveto
		1.5 C gliphO
		N moveto 1 0 rmoveto
		
		-0.5 top 1 add
		-0.5 top 4 add
		C -0.5 2.5 2add
		curveto
	}
	/GreekSmallLetterEpsilon {
		5 setconfig lowertop
		/center 2.5 def
		C moveto
		1.5 [B M Q M A D] many-arct lineto
	}
	/GreekSmallLetterZeta {
		5 setconfig
		1 setlinejoin 
		2 setlinecap
		0 9 moveto
		0.5 7.5
		1.5 7
		3.5 7.5 curveto
		-0.8 3
		-0.8 0
		2 0 curveto
		1.5 4 -3 gliphC
		1 -3 lineto
	}
	/GreekSmallLetterEta {
		6 setconfig lowertop
		/left inc
		A moveto
		0 top 1 arcYX
		A moveto
		2 [B C D] many-arct
		3 sub lineto
	}
	/GreekSmallLetterTheta {
		5 setconfig uppertop middleceil
		A moveto
		2 C gliphO
		1.5 middle moveto
		1 0 rlineto
	}
	/GreekSmallLetterIota {
		3 setconfig lowertop
		B moveto
		D 0.5 0 2add 
		1.5 arcYX
	}
	/GreekSmallLetterKappa {
		6 setconfig lowertop
		B moveto
		/left inc
		A 1 arcXY
		1 1.5 moveto
		C lineto
		3 3 moveto
		1.5 [4 0 5.5 0] many-arct lineto
	}
	/GreekSmallLetterLamda {
		5 setconfig lowermiddle
		A moveto Q lineto
		0.5 top moveto
		1 [1.5 top D D 0.5 0 2add] many-arct lineto
		
	}
	/GreekSmallLetterMu {
		6 setconfig lowertop
		2 setlinejoin
		/right dec
		B moveto
		2 D gliphU
		0 -3 moveto B lineto
		C moveto
		/right inc
		D 1 arcYX
	}
	/GreekSmallLetterNu {
		5 setconfig lowertop
		1 setlinejoin
		B moveto
		0.5 top
		1 top 1 sub
		1.5 0
		curveto
		right 3
		right 4
		C
		curveto
	}
	/GreekSmallLetterXi {
		6 setconfig uppertop middleceil
		B moveto
		/top dec
		/left inc
		/right dec
		1 [B C] many-arct lineto
		C moveto
		1.5 M gliphC
		/left dec
		Q moveto
		2.5 A gliphC
		/right inc
		1.5 D 3 sub gliphC
		1 -3 lineto
		
	}
	/GreekSmallLetterOmicron {
		5 setconfig lowertop
		A moveto
		2 C gliphO
	}
	/GreekSmallLetterPi {
		6 setconfig lowertop
		-0.5 top moveto
		1.5 [4.5 top 5.5 top 0.5 add] many-arct lineto
		1 top moveto 
		A 1 arcYX
		C 1 0 2sub moveto
		D 1 arcYX
	}
	/GreekSmallLetterRho {
		5 setconfig lowertop
		A moveto
		2 C gliphO
		M moveto
		0 -3 lineto
	}
	/GreekSmallLetterFinalSigma {
		6 setconfig lowertop
		/bottom -3 def
		/middle 0 def
		C moveto -1 0 rmoveto
		2.5 [B M Q ] many-arct 2pop
		1.5 [O D 2 -3] many-arct lineto
	}
	/GreekSmallLetterSigma {
		5 setconfig lowertop
		1 setlinecap
		A moveto
		2 C gliphO
		N moveto -0.5 0 rmoveto
		C 1 add lineto
	}
	/GreekSmallLetterTau {
		5 setconfig lowertop
		-0.5 top moveto
		1.5 [4 top 5 top 0.5 add] many-arct lineto
		N moveto 
		center inc 0 1 arcYX
	}
	/GreekSmallLetterUpsilon {
		5 setconfig lowertop
		B moveto
		0.5 middle 0.5 arcXY
		1.5 0 1 arcYX
		3.75 0
		4.5 3
		3.5 top
		curveto
		
	}
	/GreekSmallLetterPhi {
		7 setconfig lowertop
		%/bottom -3 def
		%/middle 0 def
		0.5 top moveto
		0 top 2 sub
		0 top 2 sub
		M
		curveto
		3 D gliphU
		C 2 sub
		C
		C 1.5 0 2sub
		curveto
		center -3 1.5 arcXY
	}
	/GreekSmallLetterChi {
		5 setconfig lowertop
		/bottom -3 def
		-0.5 top moveto
		0.7 [B D D 0.5 0 2add] many-arct lineto
		A moveto
		C lineto
	}
	/GreekSmallLetterPsi {
		7 setconfig lowertop
		B moveto 2.5 D  gliphU
		N moveto 0 2 rmoveto
		center -3 lineto
		
	}
	/GreekSmallLetterOmega {
		8 setconfig lowertop
		0.5 top moveto
		B 2 sub
		2dup
		M
		curveto
		2 P gliphU
		Q moveto
		2 D gliphU
		C 2 sub
		2dup
		C -0.5 0 2add
		curveto
	}
	/GreekThetaSymbol {
		7 setconfig uppertop middleceil
		0 2 moveto
		1
		[
			0 3 
			1.5 3 
			3.5 0 
			5.5 0 
		] many-arct 2pop
		2
		[
			5.5 0
			5.5 top 
			1.5 top 
			1.5 
			middle O
		]
		many-arct lineto
		
	}
	/GreekPhiSymbol {
		7 setconfig lowertop
		B moveto 2.5 D  gliphO
		N moveto 0 2 rmoveto
		center -3 lineto
	}
	/GreekPiSymbol {
		GreekSmallLetterOmega
		-0.5 top moveto
		C 0.5 0 2add lineto
	}
	/GreekKappaSymbol {
		8 setconfig lowertop
		1 setlinejoin 
		B translate
		0 -1 moveto
		1 [0 0 2 0 2 -3] many-arct 2pop
		B 2neg translate
		2 -3
		-2 0
		Q
		curveto
		D translate
		2 top
		-2 top 3 add
		-2 1
		curveto
		1
		[-2 0 0 0 0 1] many-arct lineto
	}
	/GreekRhoSymbol {
		5 setconfig lowertop
		A moveto
		2 C gliphO
		M moveto
		3 -3 2.5 arcYX
	}


>>