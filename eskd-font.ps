{(eskd-b-glyphs/) stealfolder} /eskd-b-glyphs ifnotkey
{(../ps-unicode/) stealfolder} /unicode ifnotkey

(../ps-math/) stealfolder
%(graph.ps) stealfile
{(../ps-lib/)(traverse.ps) steal} /many-dict-copy ifnotkey

%Матрицы прямого и наклонного шрифтов ЕСКД Б
/eskd-b-orto [0.1 0 0 0.1 0 0] def
/eskd-b-oblique [0.1 0 0.02679 0.1 0 0] def
/eskd-b-unoblique [1 0 -0.2679 1 0 0] def
%Словарь-шаблон для чертёжных шрифтов
/eskd-font-base
<<
	/afterGliph{
		stroke
	}
	
	%Процедура отмены наклона, нужно переопределить в наклонных шрифтах
	/unoblique {}
	
	%[g]
	/setconfig {
		/g exch def %определяем g
		/right g 1 sub def %легаси
		/center right 2 div def
		/left 0 def
		/bottom 0 def
		
		g a add  
		0
		% Width
			
		-2 -3  
		3 index  
		h 2 add
		%[width, 0, -2, -3, width, h+2]
		% Bounding box
		setcachedevice %Устанавливает вектор начала следующего глифа и окно отрисовки текущего

		d setlinewidth
		
		0.5 0.5 translate
		
		2 setlinecap			
		
	}
	%[]
	
	/A {left bottom} def
	/B {left top} def
	/C {right top} def
	/D {right bottom} def
	/M {left middle} def
	/N {center top} def
	/O {right middle} def
	/P {center bottom} def
	/Q {center middle} def

	%Установить верх буквы по уровню для заглавных букв
	/uppertop {
		/top h 1 sub def
		/middle top 2 div def
	}
	
	%Установить верх буквы по уровню для строчных букв
	/lowertop {
		/top c 1 sub def
		/middle top 2 div def
	}
	
	%Установить высоту строчных букв как средний уровень
	/lowermiddle {
		/middle c dec def
		/top h dec def
	}
	
	/middlefloor {
		/middle top 2 div floor def
	}
	
	/middleceil {
		/middle top 2 div ceiling def
	}
	
	/subglyph <<
		/uml {
			gsave
				0 top 1 add translate
				1 setlinejoin 
				0 setlinecap
				0.5 1 moveto
				1 0 rlineto
				1 0 rmoveto
				1 0 rlineto
				stroke
			grestore
		}
		/breve {
			gsave
				0 top 1 add translate
				0 setlinecap
				1 1 moveto
				right 1 sub 1 lineto
				stroke
			grestore
		}
		/dot {
			gsave
				0 top inc translate
				1 setlinejoin 
				0 setlinecap
				0 2.5 moveto
				0 1.5 lineto
				stroke
			grestore
		}
	>>

>> 
font3-base
<< >> copy copy
dup begin
	(font-tools.ps) stealfile
end

def


%=============

/eskd-b-font-base
<<
	
	%========== Специфичные члены для ЕСКД Б
	/h 10 %высота прописных букв
	/c 7  %высота строчных букв
	/a 2  %расстояние между буквами
	/b 17 %интерлиньяж
	/e 6  %расстояние между словами
	/d 1  % толщина линии
	
	/CharProcs eskd-b-glyphs
	
>>
eskd-font-base
<<>> copy copy
def

/eskd-utf-encoding-dict 
	[
		(0123456789АБВГДЕЁЖЗИЙКЛМНОПРСТУФХЦЧШЩЪЫЬЭЮЯабвгдеёжзийклмнопрстуфхцчшщъыьэюя ) utf8load
		(ABCDEFGHIJKLPMNOPQRSTUVWXYZ) utf8load
		(abcdefghijklpmnopqrstuvwxyz) utf8load
		(.:,;+-?!°) utf8load
		16#2080 16#2081 16#2082 16#2083 16#2084 16#2085 16#2086 16#2087 16#2088 16#2089 
		16#2300
		
		%greek
		16#0391 16#0392 16#0393 16#0394 16#0395 16#0396 16#0397 16#0398 
		16#0399 16#039A 16#039B 16#039C 16#039D 16#039E 16#039F 16#03A0 
		16#03A1 16#03A3 16#03A4 16#03A5 16#03A6 16#03A7 16#03A8 16#03A9 
		16#03B1 16#03B2 16#03B3 16#03B4 16#03B5 16#03B6 16#03B7 16#03B8 
		16#03B9 16#03BA 16#03BB 16#03BC 16#03BD 16#03BE 16#03BF 16#03C0 
		16#03C1 16#03C2 16#03C3 16#03C4 16#03C5 16#03C6 16#03C7 16#03C8 
		16#03C9 16#03D1 16#03D5 16#03D6 16#03F0 16#03F1

	]
	%dup (encoding dict len) = length ==
	encoding-from-points
def

%====
%Шрифты ЕСКД

/eskd-b-font dup
	[
		eskd-utf-encoding-dict
		eskd-b-font-base
		<<
			/FontMatrix eskd-b-oblique
			/FontName (ESKD B)
			
			/unoblique{ eskd-b-unoblique concat}
			
		>>
	]
	many-dict-copy
definefont def

/eskd-b-orto-font dup
	[
		eskd-utf-encoding-dict
		eskd-b-font-base
		<<
			/FontMatrix eskd-b-orto
			/FontName (ESKD B orto)
			
		>>
	]
	many-dict-copy
definefont def